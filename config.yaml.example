active_profile: ayol
audio:
  channels: 1
  input_device: null
  output_device: null
  sample_rate: 16000
language: uz
llm:
  local_timeout_sec: 15
  providers:
  - base_url: http://localhost:11434
    model: qwen2.5:0.5b
    name: ollama
  timeout_sec: 5
logging:
  level: INFO
ollama:
  model: qwen2.5:0.5b
  timeout: 30
  url: http://localhost:11434
piper:
  binary: /usr/local/bin/piper
  model: /opt/alisa/models/tr_TR-fahrettin-medium.onnx
  output_dir: /tmp/alisa_tts
profiles:
  ayol:
    espeak_pitch: 70
    espeak_speed: 130
    espeak_voice: uz+f3
    name: Zilola
    pitch: +15Hz
    rate: -5%
    voice: uz-UZ-MadinaNeural
  erkak:
    espeak_pitch: 25
    espeak_speed: 125
    espeak_voice: uz
    name: Vali
    pitch: -20Hz
    rate: +5%
    voice: uz-UZ-SardorNeural
  robot_ayol:
    espeak_pitch: 75
    espeak_speed: 130
    espeak_voice: uz+f3
    name: Zilola
    pitch: +15Hz
    rate: -5%
    voice: uz-UZ-MadinaNeural
  robot_erkak:
    espeak_pitch: 20
    espeak_speed: 120
    espeak_voice: uz
    name: Vali
    pitch: -20Hz
    rate: +5%
    voice: uz-UZ-SardorNeural
reception:
  address: ''
  greeting: Assalomu alaykum! Sizga qanday yordam bera olaman?
  voice_threshold: 500
  work_hours: 9:00 - 18:00
scheduler:
  enabled: false
stt:
  compute_type: int8
  cpu_threads: 4
  device: cpu
  language: uz
  model: small
telegram:
  bot_token: ''
  chat_id: ''
tts:
  espeak_pitch: 70
  espeak_speed: 130
  espeak_voice: uz+f3
  pitch: +15Hz
  rate: -5%
  voice: uz-UZ-MadinaNeural
updater:
  git_branch: null
  pip_path: /home/baxrom/alisa_ai/.venv/bin/pip
wake_word:
  allow_proxy_model: false
  confirmation_cooldown_sec: 3.0
  energy_gated:
    min_duration_ms: 100
    threshold: 500
  keyword: alisa
  method: energy_gated
  openwakeword:
    inference_framework: onnx
    model: alexa
  sensitivity: 0.5
web_dashboard:
  enabled: false
whisper:
  binary: /usr/local/bin/whisper-cli
  language: uz
  model: /opt/alisa/models/ggml-small.bin
