# Database: SQLite is the local default. Use asyncpg for production PostgreSQL.
# Example PostgreSQL URL: postgresql+asyncpg://user:password@localhost:5432/kitobxon
DATABASE_URL=sqlite+aiosqlite:///./kitobxon.db

# Set to production in deployed environments. Production startup refuses the
# built-in default SECRET_KEY and requires the database to be at Alembic head.
ENVIRONMENT=development
RUN_MIGRATIONS_ON_STARTUP=false

# Replace in every deployed environment. JWT access tokens expire after 24 hours.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional explicit admin bootstrap. If both are set and no admin exists,
# startup creates or promotes this user.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Storage backend: local or supabase.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# Required only when STORAGE_BACKEND=supabase.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=kitobxon

# Upload limits in bytes: 50MB for book files, 200MB for audio files.
MAX_BOOK_FILE_SIZE=52428800
MAX_AUDIO_FILE_SIZE=209715200

# Disable only in tests or trusted local profiling sessions.
RATE_LIMIT_ENABLED=true
# Use memory:// locally. Use a Redis URL in multi-instance deployments.
RATE_LIMIT_STORAGE_URL=memory://

# JSON array parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
